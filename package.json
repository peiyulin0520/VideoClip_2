{
  "name": "little-moments-videoclip-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4173",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "fonts": "NODE_USE_ENV_PROXY=1 node scripts/fetch-fonts.mjs && .venv/bin/python -I scripts/build-fonts.py",
    "fonts:setup": "python3 -m venv .venv && .venv/bin/pip install -r scripts/requirements.txt",
    "check": "npm run lint && npm test && npm run build && npm run verify:pages",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "immer": "^11.2.10",
    "lucide-react": "^1.72.0",
    "mediabunny": "^1.65.2",
    "pixi.js": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
